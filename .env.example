# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# Clé publishable (sb_publishable_…) ; l'ancienne clé anon JWT fonctionne aussi
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Clé secrète (sb_secret_…), côté serveur uniquement : fils de discussion, revue par les pairs, travailleur des agents.
# Remplace la clé service_role héritée (SUPABASE_SERVICE_ROLE_KEY, encore acceptée en repli).
SUPABASE_SECRET_KEY=sb_secret_...

# Application Environment
NODE_ENV=development

# N8N Webhooks for AI Analysis
N8N_WEBHOOK_TEST=https://n8n.example.com/webhook-test/your-test-id
N8N_WEBHOOK_PROD=https://n8n.example.com/webhook/your-prod-id
N8N_DEFENSE_ANALYSIS_WEBHOOK_URL=https://n8n.example.com/webhook/your-defense-analysis-id
N8N_PRESENTATION_ANALYSIS_WEBHOOK_URL=https://n8n.example.com/webhook/your-presentation-analysis-id
N8N_SOUTENANCE_WEBHOOK_URL=https://n8n.example.com/webhook/your-soutenance-id
N8N_TRANSCRIPTION_WEBHOOK_URL=https://n8n.example.com/webhook/your-transcription-id
N8N_WEBHOOK_TOKEN=your-secret-token-here

# Agents d'analyse (007-agents) — appels au modèle via OpenRouter depuis l'application
OPENROUTER_API_KEY=sk-or-v1-...
# Identifiant OpenRouter du modèle proposé par défaut à la création d'un agent
OPENROUTER_DEFAULT_MODEL=anthropic/claude-opus-5
# Secret partagé entre le déclencheur (lancement, pg_cron) et la route travailleur /api/agents/worker
AGENT_WORKER_SECRET=change-me
# Origine publique de l'application (en-tête d'attribution OpenRouter et, à défaut d'AGENT_WORKER_URL, cible du travailleur)
NEXT_PUBLIC_APP_URL=https://rfp-analyzer.vercel.app
# Facultatif : origine à appeler pour le travailleur si elle diffère de celle de la requête
# AGENT_WORKER_URL=https://rfp-analyzer.vercel.app
